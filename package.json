{
  "name": "@uninterface/backend-element-plus",
  "version": "2.14.0-alpha1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css",
    "./capabilities.json": "./capabilities.json",
    "./*.vue": "./src/*.vue",
    "./integration": "./src/integration.ts",
    "./vite": "./src/vite.mjs",
    "./layout": "./src/layout.ts",
    "./testing": "./testing/index.ts",
    "./testing/dom": "./testing/dom.mjs",
    "./focus": "./src/focus.ts",
    "./font.css": "./src/font.css",
    "./font-bundled.css": "./src/font-bundled.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "element-plus": "2.14.7"
  },
  "description": "Element Plus presentation backend for Uninterface.",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@uninterface/fonts": "0.0.2",
    "@uninterface/testing": "0.0.2",
    "@uninterface/uninterface": "0.0.3",
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue": "3.5.43",
    "vue-tsc": "3.1.1"
  },
  "uninterface": {
    "testing": {
      "typography": "testing/typography.json",
      "componentConformance": {
        "collectionFooterSharesAt435": false,
        "retainsEditorsOnColumnReorder": false,
        "checkableModes": [
          "flushed",
          "control-aligned",
          "separated"
        ],
        "fieldLabels": {
          "placements": [
            "beside-near",
            "beside-far"
          ],
          "resolves": {
            "beside": "beside-near",
            "floating": "show"
          }
        },
        "fieldSizing": {
          "small": {
            "fontSize": "smaller"
          },
          "extraLarge": {
            "lineHeight": "larger"
          }
        },
        "fieldHelp": "together",
        "loadingIndicator": {
          "selector": ".el-icon.is-loading",
          "motion": "stops"
        },
        "navigation": "menubar",
        "segmentedLabelBeside": true
      },
      "popoverArrow": {
        "selector": ".el-popper__arrow",
        "placementAttribute": "data-popper-placement"
      },
      "dom": [
        "testing/native-component-integration.test.mjs",
        "testing/strategy-native-presentation.test.mjs",
        "testing/strategy-native-defaults.test.mjs",
        "testing/stacking-select.test.mjs",
        "testing/native-locale.test.mjs",
        "testing/temporal-presentation.test.mjs",
        "testing/temporal-range.test.mjs",
        "testing/menu-dom.test.mjs",
        "testing/popup-position.test.mjs",
        "testing/vite-dependencies.test.mjs",
        "testing/modal-presentation.test.mjs",
        "testing/collapsible-presentation.test.mjs",
        "testing/navigation.test.mjs",
        "testing/upload-presentation.test.mjs",
        "testing/switch-keyboard.test.mjs",
        "testing/paginator-presentation.test.mjs",
        "testing/feedback-presentation.test.mjs",
        "testing/overlay-arrows.test.mjs",
        "testing/neutral-button.test.mjs"
      ],
      "reference": {
        "page": "testing/native-reference.html",
        "browser": "testing/native-reference.spec.ts"
      },
      "browser": [
        "testing/table-ssr-native.spec.ts",
        "testing/native-paint.spec.ts",
        "testing/navbar-spacing.spec.ts",
        "testing/navigation-browser.spec.ts",
        "testing/temporal-fields.spec.ts",
        "testing/component-conformance.spec.ts",
        "testing/collection-element-badges.spec.ts",
        "testing/stacking-popups.spec.ts",
        "testing/navigation-scroll.spec.ts",
        "testing/menu.spec.ts",
        "testing/notice.spec.ts",
        "testing/composed-arrows.spec.ts",
        "testing/table-sorting.spec.ts",
        "testing/validation-feedback.spec.ts",
        "testing/feedback-presentation.spec.ts"
      ],
      "paginatorGeometry": {
        "sizeSurface": ".element-paginator-size .el-select__wrapper",
        "jumperSurface": ".element-paginator-jumper .el-input__wrapper",
        "jumperRoot": ".element-paginator-jumper"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uninterface/backend-element-plus.git"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs"
  },
  "peerDependencies": {
    "@uninterface/testing": "~0.0.2",
    "@uninterface/uninterface": "~0.0.3",
    "vue": "^3.5.43"
  },
  "peerDependenciesMeta": {
    "@uninterface/testing": {
      "optional": true
    }
  },
  "overrides": {
    "tough-cookie": {
      "tldts": "7.4.18"
    },
    "tldts": {
      "tldts-core": "7.4.18"
    }
  }
}
